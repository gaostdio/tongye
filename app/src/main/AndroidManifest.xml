                <action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/><data android:mimeType="application/x-tongye-couple"/><data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/x-tongye-couple"/><data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
